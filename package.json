{
  "name": "inertia-native",
  "version": "0.1.0-beta.1",
  "description": "Drive Inertia.js navigation and bridge components from Hotwire Native (iOS & Android)",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    },
    "./vue": {
      "types": "./src/vue.d.ts",
      "import": "./src/vue.js"
    },
    "./svelte": {
      "types": "./src/svelte.d.ts",
      "import": "./src/svelte.js"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "oxlint src/ tests/",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "hotwire",
    "hotwire-native",
    "inertia",
    "inertiajs",
    "turbo-native",
    "ios",
    "android",
    "rails",
    "react",
    "vue",
    "svelte"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inertia-native/inertia-native.git"
  },
  "homepage": "https://inertia-native.dev",
  "bugs": "https://github.com/inertia-native/inertia-native/issues",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@inertiajs/core": ">=2.0.0",
    "react": ">=18.0.0",
    "svelte": ">=4.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/core": "^3.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.0.0"
  }
}
